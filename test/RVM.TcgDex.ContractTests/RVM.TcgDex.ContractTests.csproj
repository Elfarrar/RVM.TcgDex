<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Contrato contra a API REAL da TCGdex. NAO roda no CI de PR (ci.yml testa so o projeto unitario)
    nem na publicacao: so no contract.yml, diario e manual. Falha la vira issue.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RVM.TcgDex\RVM.TcgDex.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="contract-baseline.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
